# API Proxy Configuration (RECOMMENDED for production security)
# Deploy the Cloudflare Worker from cloudflare-worker/hvac-proxy-worker.js
# Set to 'true' to enable secure proxy for API calls
VITE_USE_PROXY=false
# Your Cloudflare Worker URL (e.g., https://hvac-control-proxy.your-subdomain.workers.dev)
VITE_PROXY_URL=

# SmartThings Personal Access Token
# Get your token from: https://account.smartthings.com/tokens
# Required permissions: r:devices:*, r:devices:*:status, x:devices:* (for control)
# NOTE: Only needed for direct API calls (dev mode). In production, token is stored in Cloudflare Worker
VITE_SMARTTHINGS_TOKEN=your_smartthings_token_here

# Google Sheets API Key (for control settings and fallback temperature data)
# Get your API key from: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_SHEETS_API_KEY=your_api_key_here

# Google OAuth Client ID (REQUIRED for write access)
# Get your OAuth Client ID from: https://console.cloud.google.com/apis/credentials
# Must be configured as a "Web application" with authorized JavaScript origins
VITE_GOOGLE_CLIENT_ID=your_client_id_here

# IFTTT Webhook Key (for light/plug/lock control)
# Get this from: https://ifttt.com/maker_webhooks/settings
# NOTE: Only needed for direct IFTTT calls (dev mode). In production, key is stored in Cloudflare Worker
VITE_IFTTT_WEBHOOK_KEY=your_ifttt_key_here
